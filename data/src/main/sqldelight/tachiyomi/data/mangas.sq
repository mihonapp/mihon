import eu.kanade.tachiyomi.source.model.UpdateStrategy;
import kotlin.Boolean;
import kotlin.String;
import kotlin.collections.List;
import kotlinx.serialization.json.JsonObject;

CREATE TABLE mangas(
    _id INTEGER NOT NULL PRIMARY KEY,
    source INTEGER NOT NULL,
    url TEXT NOT NULL,
    artist TEXT,
    author TEXT,
    description TEXT,
    genre TEXT AS List<String>,
    title TEXT NOT NULL,
    status INTEGER NOT NULL,
    thumbnail_url TEXT,
    last_update INTEGER,
    next_update INTEGER,
    initialized INTEGER AS Boolean NOT NULL,
    viewer INTEGER NOT NULL,
    chapter_flags INTEGER NOT NULL,
    cover_last_modified INTEGER NOT NULL,
    update_strategy INTEGER AS UpdateStrategy NOT NULL DEFAULT 0,
    calculate_interval INTEGER DEFAULT 0 NOT NULL,
    notes TEXT NOT NULL DEFAULT "",
    memo BLOB AS JsonObject NOT NULL DEFAULT '{}',
    favorite_at INTEGER
);

CREATE INDEX library_favorite_at_index ON mangas(favorite_at) WHERE favorite_at IS NOT NULL;
CREATE INDEX mangas_url_index ON mangas(url);
CREATE INDEX idx_mangas_source ON mangas(source);

getMangaById:
SELECT
    _id, source, url, artist, author, description, genre, title,
    status, thumbnail_url, last_update, next_update, initialized,
    viewer, chapter_flags, cover_last_modified, update_strategy,
    calculate_interval, notes, memo, favorite_at
FROM mangas
WHERE _id = :id;

-- TODO: this should ideally never really have more than 1 result
getMangaByUrlAndSource:
SELECT
    _id, source, url, artist, author, description, genre, title,
    status, thumbnail_url, last_update, next_update, initialized,
    viewer, chapter_flags, cover_last_modified, update_strategy,
    calculate_interval, notes, memo, favorite_at
FROM mangas
WHERE url = :url
AND source = :source
LIMIT 1;

getFavorites:
SELECT
    _id, source, url, artist, author, description, genre, title,
    status, thumbnail_url, last_update, next_update, initialized,
    viewer, chapter_flags, cover_last_modified, update_strategy,
    calculate_interval, notes, memo, favorite_at
FROM mangas
WHERE favorite_at IS NOT NULL;

getReadMangaNotInLibrary:
SELECT
    _id, source, url, artist, author, description, genre, title,
    status, thumbnail_url, last_update, next_update, initialized,
    viewer, chapter_flags, cover_last_modified, update_strategy,
    calculate_interval, notes, memo, favorite_at
FROM mangas
WHERE favorite_at IS NULL AND _id IN (
    SELECT DISTINCT chapters.manga_id
    FROM chapters
    WHERE read = 1 OR last_page_read != 0
);

getAllManga:
SELECT
    _id, source, url, artist, author, description, genre, title,
    status, thumbnail_url, last_update, next_update, initialized,
    viewer, chapter_flags, cover_last_modified, update_strategy,
    calculate_interval, notes, memo, favorite_at
FROM mangas;

getAllMangaSourceAndUrl:
SELECT source, url
FROM mangas;

getSourceIdWithFavoriteCount:
SELECT
source,
count(*)
FROM mangas
WHERE favorite_at IS NOT NULL
GROUP BY source;

getFavoriteBySourceId:
SELECT
    _id, source, url, artist, author, description, genre, title,
    status, thumbnail_url, last_update, next_update, initialized,
    viewer, chapter_flags, cover_last_modified, update_strategy,
    calculate_interval, notes, memo, favorite_at
FROM mangas
WHERE favorite_at IS NOT NULL
AND source = :sourceId;

getDuplicateLibraryManga:
WITH
track_dupes AS (
    SELECT DISTINCT S2.manga_id
    FROM manga_sync S1
    INNER JOIN manga_sync S2
    ON S1.sync_id = S2.sync_id
    AND S1.remote_id = S2.remote_id
    AND S1.remote_id != 0
    AND S1.manga_id != S2.manga_id
    WHERE S1.manga_id = :id
),
duplicates AS (
    SELECT
        M._id, M.source, M.url, M.artist, M.author, M.description, M.genre, M.title,
        M.status, M.thumbnail_url, M.last_update, M.next_update, M.initialized,
        M.viewer, M.chapter_flags, M.cover_last_modified, M.update_strategy,
        M.calculate_interval, M.notes, M.memo, M.favorite_at
    FROM mangas M
    LEFT JOIN track_dupes D
    ON D.manga_id = _id
    WHERE favorite_at IS NOT NULL
    AND _id != :id
    AND (lower(title) LIKE '%' || lower(:title) || '%' OR D.manga_id IS NOT NULL)
),
chapter_counts AS (
    SELECT
        M._id AS manga_id,
        count(*) AS chapter_count
    FROM duplicates M
    JOIN chapters C
    ON M._id = C.manga_id
    LEFT JOIN excluded_scanlators ES
    ON C.manga_id = ES.manga_id
    AND C.scanlator = ES.scanlator
    WHERE ES.scanlator IS NULL
    GROUP BY M._id
)
SELECT
    M._id, M.source, M.url, M.artist, M.author, M.description, M.genre, M.title,
    M.status, M.thumbnail_url, M.last_update, M.next_update, M.initialized,
    M.viewer, M.chapter_flags, M.cover_last_modified, M.update_strategy,
    M.calculate_interval, M.notes, M.memo, M.favorite_at,
    coalesce(CC.chapter_count, 0) AS chapter_count
FROM duplicates M
LEFT JOIN chapter_counts CC
ON M._id = CC.manga_id;

getUpcomingManga:
SELECT
    _id, source, url, artist, author, description, genre, title,
    status, thumbnail_url, last_update, next_update, initialized,
    viewer, chapter_flags, cover_last_modified, update_strategy,
    calculate_interval, notes, memo, favorite_at
FROM mangas
WHERE next_update >= :startOfDay
AND favorite_at IS NOT NULL
AND status IN :statuses
AND (
    -- includedEmpty being true expresses "don't care" state and bypasses the membership filter
    :includedEmpty
    OR EXISTS (
        SELECT 1 FROM mangas_categories
        WHERE mangas_categories.manga_id = mangas._id
        AND COALESCE(mangas_categories.category_id, 0) IN :includedCategories
    )
    OR (0 IN :includedCategories AND NOT EXISTS (
        SELECT 1 FROM mangas_categories WHERE mangas_categories.manga_id = mangas._id)
    )
)
AND (
    -- excludedEmpty being true expresses "don't care" state and bypasses the membership filter
    :excludedEmpty
    OR (
        NOT EXISTS (
            SELECT 1 FROM mangas_categories
            WHERE mangas_categories.manga_id = mangas._id
            AND COALESCE(mangas_categories.category_id, 0) IN :excludedCategories
        )
        AND (
            0 NOT IN :excludedCategories
            OR EXISTS (SELECT 1 FROM mangas_categories WHERE mangas_categories.manga_id = mangas._id)
        )
    )
)
ORDER BY next_update ASC;

resetViewerFlags:
UPDATE mangas
SET viewer = 0;

getSourceIdsWithNonLibraryManga:
SELECT source, COUNT(*) AS manga_count
FROM mangas
WHERE favorite_at IS NULL
GROUP BY source;

deleteNonLibraryManga:
DELETE FROM mangas
WHERE favorite_at IS NULL
AND source IN :sourceIds
AND (
    :keepReadManga = 0
    OR _id NOT IN (
        SELECT DISTINCT manga_id
        FROM chapters
        WHERE read = 1
        OR last_page_read != 0
    )
);

insertReturningId:
INSERT INTO mangas(source, url, artist, author, description, genre, title, status, thumbnail_url, favorite_at, last_update, next_update, initialized, viewer, chapter_flags, cover_last_modified, update_strategy, calculate_interval, notes, memo)
VALUES (:source, :url, :artist, :author, :description, :genre, :title, :status, :thumbnailUrl, :favoriteAt, :lastUpdate, :nextUpdate, :initialized, :viewerFlags, :chapterFlags, :coverLastModified, :updateStrategy, :calculateInterval, :notes, :memo)
RETURNING _id;

update:
UPDATE mangas SET
    -- NULL is a real value here (not in the library), which coalesce cannot write
    favorite_at = CASE WHEN :favoriteAtSet THEN :favoriteAt ELSE favorite_at END,
    last_update = coalesce(:lastUpdate, last_update),
    next_update = coalesce(:nextUpdate, next_update),
    viewer = coalesce(:viewer, viewer),
    chapter_flags = coalesce(:chapterFlags, chapter_flags),
    cover_last_modified = coalesce(:coverLastModified, cover_last_modified),
    calculate_interval = coalesce(:calculateInterval, calculate_interval),
    notes = coalesce(:notes, notes)
WHERE _id = :mangaId;

updateFromBackup:
UPDATE mangas SET
    artist = coalesce(:artist, artist),
    author = coalesce(:author, author),
    description = coalesce(:description, description),
    genre = coalesce(:genre, genre),
    title = coalesce(:title, title),
    status = coalesce(:status, status),
    thumbnail_url = coalesce(:thumbnailUrl, thumbnail_url),
    favorite_at = :favoriteAt,
    last_update = coalesce(:lastUpdate, last_update),
    initialized = coalesce(:initialized, initialized),
    viewer = coalesce(:viewer, viewer),
    chapter_flags = coalesce(:chapterFlags, chapter_flags),
    cover_last_modified = coalesce(:coverLastModified, cover_last_modified),
    update_strategy = coalesce(:updateStrategy, update_strategy),
    notes = coalesce(:notes, notes),
    memo = coalesce(:memo, memo)
WHERE _id = :mangaId;

updateRemote:
UPDATE mangas SET
    artist = coalesce(:artist, artist),
    author = coalesce(:author, author),
    description = coalesce(:description, description),
    genre = coalesce(:genre, genre),
    title = coalesce(:title, title),
    status = :status,
    thumbnail_url = coalesce(:thumbnailUrl, thumbnail_url),
    initialized = :initialized,
    cover_last_modified = coalesce(:coverLastModified, cover_last_modified),
    update_strategy = :updateStrategy,
    memo = :memo
WHERE _id = :mangaId;

insertNetworkManga {
    -- Insert the manga if it doesn't exist already
    INSERT INTO mangas(
        source, url, artist, author, description, genre, title, status, thumbnail_url, favorite_at,
        last_update, next_update, initialized, viewer, chapter_flags, cover_last_modified,
        update_strategy, calculate_interval, memo
    )
    SELECT
        :source, :url, :artist, :author, :description, :genre, :title, :status, :thumbnailUrl, :favoriteAt,
        :lastUpdate, :nextUpdate, :initialized, :viewerFlags, :chapterFlags, :coverLastModified,
        :updateStrategy, :calculateInterval, :memo
    WHERE NOT EXISTS(SELECT 0 FROM mangas WHERE source = :source AND url = :url);

    -- Update the relevant details if applicable and not favorite
    UPDATE mangas
    SET
        title = CASE WHEN :updateTitle THEN :title ELSE title END,
        thumbnail_url = CASE WHEN :updateCover THEN :thumbnailUrl ELSE thumbnail_url END,
        author = CASE WHEN :updateDetails THEN :author ELSE author END,
        artist = CASE WHEN :updateDetails THEN :artist ELSE artist END,
        description = CASE WHEN :updateDetails THEN :description ELSE description END,
        genre = CASE WHEN :updateDetails THEN :genre ELSE genre END,
        status = CASE WHEN :updateDetails THEN :status ELSE status END,
        update_strategy = CASE WHEN :updateDetails THEN :updateStrategy ELSE update_strategy END,
        initialized = :updateDetails,
        memo = :memo
    WHERE source = :source
    AND url = :url
    AND favorite_at IS NULL;

    -- Finally return the manga
    SELECT
        _id, source, url, artist, author, description, genre, title,
        status, thumbnail_url, last_update, next_update, initialized,
        viewer, chapter_flags, cover_last_modified, update_strategy,
        calculate_interval, notes, memo, favorite_at
    FROM mangas
    WHERE source = :source
    AND url = :url
    LIMIT 1;
}
