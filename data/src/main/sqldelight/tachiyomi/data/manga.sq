import eu.kanade.tachiyomi.source.model.UpdateStrategy;
import kotlin.Boolean;
import kotlin.String;
import kotlin.collections.List;
import kotlinx.serialization.json.JsonObject;

CREATE TABLE manga(
    id INTEGER NOT NULL PRIMARY KEY,
    source_id INTEGER NOT NULL,
    remote_url TEXT NOT NULL,
    remote_title TEXT NOT NULL,
    remote_author TEXT,
    remote_artist TEXT,
    remote_description TEXT,
    remote_genre TEXT AS List<String>,
    remote_status INTEGER NOT NULL,
    remote_cover TEXT,
    remote_update_strategy INTEGER AS UpdateStrategy NOT NULL,
    remote_memo BLOB AS JsonObject NOT NULL,
    user_favorite_at INTEGER,
    user_notes TEXT NOT NULL,
    user_reader_flags INTEGER NOT NULL,
    user_chapter_flags INTEGER NOT NULL,
    state_chapter_last_update INTEGER,
    state_chapter_next_update INTEGER,
    state_chapter_fetch_interval INTEGER NOT NULL,
    state_cover_last_modified INTEGER NOT NULL,
    state_initialized INTEGER AS Boolean NOT NULL,
    UNIQUE(source_id, remote_url)
);

CREATE INDEX manga_user_favorite_at_index ON manga(user_favorite_at) WHERE user_favorite_at IS NOT NULL;

getMangaById:
SELECT
    id, source_id, remote_url, remote_title, remote_author, remote_artist, remote_description,
    remote_genre, remote_status, remote_cover, remote_update_strategy, remote_memo,
    user_favorite_at, user_notes, user_reader_flags, user_chapter_flags,
    state_chapter_last_update, state_chapter_next_update, state_chapter_fetch_interval,
    state_cover_last_modified, state_initialized
FROM manga
WHERE id = :id;

getMangaByUrlAndSource:
SELECT
    id, source_id, remote_url, remote_title, remote_author, remote_artist, remote_description,
    remote_genre, remote_status, remote_cover, remote_update_strategy, remote_memo,
    user_favorite_at, user_notes, user_reader_flags, user_chapter_flags,
    state_chapter_last_update, state_chapter_next_update, state_chapter_fetch_interval,
    state_cover_last_modified, state_initialized
FROM manga
WHERE source_id = :sourceId
AND remote_url = :remoteUrl;

getFavorites:
SELECT
    id, source_id, remote_url, remote_title, remote_author, remote_artist, remote_description,
    remote_genre, remote_status, remote_cover, remote_update_strategy, remote_memo,
    user_favorite_at, user_notes, user_reader_flags, user_chapter_flags,
    state_chapter_last_update, state_chapter_next_update, state_chapter_fetch_interval,
    state_cover_last_modified, state_initialized
FROM manga
WHERE user_favorite_at IS NOT NULL;

getReadMangaNotInLibrary:
SELECT
    id, source_id, remote_url, remote_title, remote_author, remote_artist, remote_description,
    remote_genre, remote_status, remote_cover, remote_update_strategy, remote_memo,
    user_favorite_at, user_notes, user_reader_flags, user_chapter_flags,
    state_chapter_last_update, state_chapter_next_update, state_chapter_fetch_interval,
    state_cover_last_modified, state_initialized
FROM manga
WHERE user_favorite_at IS NULL
AND EXISTS (
    SELECT 1
    FROM chapter
    WHERE chapter.manga_id = manga.id
    AND (user_read = 1 OR user_last_page_read != 0)
);

getAllMangaSourceAndUrl:
SELECT source_id, remote_url
FROM manga;

getSourceIdWithFavoriteCount:
SELECT source_id, count(*)
FROM manga
WHERE user_favorite_at IS NOT NULL
GROUP BY source_id;

getFavoriteBySourceId:
SELECT
    id, source_id, remote_url, remote_title, remote_author, remote_artist, remote_description,
    remote_genre, remote_status, remote_cover, remote_update_strategy, remote_memo,
    user_favorite_at, user_notes, user_reader_flags, user_chapter_flags,
    state_chapter_last_update, state_chapter_next_update, state_chapter_fetch_interval,
    state_cover_last_modified, state_initialized
FROM manga
WHERE user_favorite_at IS NOT NULL
AND source_id = :sourceId;

getDuplicateLibraryManga:
WITH
track_dupes AS (
    SELECT DISTINCT T2.manga_id
    FROM manga_track T1
    JOIN manga_track T2
    ON T1.tracker_id = T2.tracker_id
    AND T1.remote_id = T2.remote_id
    AND T1.remote_id != 0
    AND T1.manga_id != T2.manga_id
    WHERE T1.manga_id = :id
)
SELECT
    M.id, M.source_id, M.remote_url, M.remote_title, M.remote_author, M.remote_artist,
    M.remote_description, M.remote_genre, M.remote_status, M.remote_cover,
    M.remote_update_strategy, M.remote_memo, M.user_favorite_at, M.user_notes,
    M.user_reader_flags, M.user_chapter_flags, M.state_chapter_last_update,
    M.state_chapter_next_update, M.state_chapter_fetch_interval,
    M.state_cover_last_modified, M.state_initialized,
    (
        SELECT count(*)
        FROM chapter C
        LEFT JOIN excluded_scanlator ES
        ON C.manga_id = ES.manga_id
        AND C.remote_scanlator = ES.scanlator
        WHERE C.manga_id = M.id
        AND ES.scanlator IS NULL
    ) AS chapter_count
FROM manga M
WHERE M.user_favorite_at IS NOT NULL
AND M.id != :id
AND (lower(M.remote_title) LIKE '%' || lower(:remoteTitle) || '%' OR M.id IN (SELECT manga_id FROM track_dupes));

getUpcomingManga:
SELECT
    id, source_id, remote_url, remote_title, remote_author, remote_artist, remote_description,
    remote_genre, remote_status, remote_cover, remote_update_strategy, remote_memo,
    user_favorite_at, user_notes, user_reader_flags, user_chapter_flags,
    state_chapter_last_update, state_chapter_next_update, state_chapter_fetch_interval,
    state_cover_last_modified, state_initialized
FROM manga
WHERE state_chapter_next_update >= :startOfDay
AND user_favorite_at IS NOT NULL
AND remote_status IN :statuses
AND (
    -- includedEmpty being true expresses "don't care" state and bypasses the membership filter
    :includedEmpty
    OR EXISTS (
        SELECT 1 FROM manga_category
        WHERE manga_category.manga_id = manga.id
        AND manga_category.category_id IN :includedCategories
    )
    OR (0 IN :includedCategories AND NOT EXISTS (
        SELECT 1 FROM manga_category WHERE manga_category.manga_id = manga.id)
    )
)
AND (
    -- excludedEmpty being true expresses "don't care" state and bypasses the membership filter
    :excludedEmpty
    OR (
        NOT EXISTS (
            SELECT 1 FROM manga_category
            WHERE manga_category.manga_id = manga.id
            AND manga_category.category_id IN :excludedCategories
        )
        AND (
            0 NOT IN :excludedCategories
            OR EXISTS (SELECT 1 FROM manga_category WHERE manga_category.manga_id = manga.id)
        )
    )
)
ORDER BY state_chapter_next_update ASC;

resetViewerFlags:
UPDATE manga
SET user_reader_flags = 0
WHERE user_reader_flags != 0;

getSourceIdsWithNonLibraryManga:
SELECT source_id, count(*) AS manga_count
FROM manga
WHERE user_favorite_at IS NULL
GROUP BY source_id;

deleteNonLibraryManga:
DELETE FROM manga
WHERE user_favorite_at IS NULL
AND source_id IN :sourceIds
AND (
    :keepReadManga = 0
    OR NOT EXISTS (
        SELECT 1
        FROM chapter
        WHERE chapter.manga_id = manga.id
        AND (user_read = 1 OR user_last_page_read != 0)
    )
);

insertReturningId:
INSERT INTO manga(
    source_id, remote_url, remote_title, remote_author, remote_artist, remote_description,
    remote_genre, remote_status, remote_cover, remote_update_strategy, remote_memo,
    user_favorite_at, user_notes, user_reader_flags, user_chapter_flags,
    state_chapter_last_update, state_chapter_next_update, state_chapter_fetch_interval,
    state_cover_last_modified, state_initialized
)
VALUES (
    :sourceId, :remoteUrl, :remoteTitle, :remoteAuthor, :remoteArtist, :remoteDescription,
    :remoteGenre, :remoteStatus, :remoteCover, :remoteUpdateStrategy, :remoteMemo,
    :userFavoriteAt, :userNotes, :userReaderFlags, :userChapterFlags,
    :stateChapterLastUpdate, :stateChapterNextUpdate, :stateChapterFetchInterval,
    :stateCoverLastModified, :stateInitialized
)
RETURNING id;

update:
UPDATE manga SET
    -- NULL is a real value here (not in the library), which coalesce cannot write
    user_favorite_at = CASE WHEN :userFavoriteAtSet THEN :userFavoriteAt ELSE user_favorite_at END,
    user_notes = coalesce(:userNotes, user_notes),
    user_reader_flags = coalesce(:userReaderFlags, user_reader_flags),
    user_chapter_flags = coalesce(:userChapterFlags, user_chapter_flags),
    state_chapter_last_update = coalesce(:stateChapterLastUpdate, state_chapter_last_update),
    state_chapter_next_update = coalesce(:stateChapterNextUpdate, state_chapter_next_update),
    state_chapter_fetch_interval = coalesce(:stateChapterFetchInterval, state_chapter_fetch_interval),
    state_cover_last_modified = coalesce(:stateCoverLastModified, state_cover_last_modified)
WHERE id = :id;

updateFromBackup:
UPDATE manga SET
    remote_title = coalesce(:remoteTitle, remote_title),
    remote_author = coalesce(:remoteAuthor, remote_author),
    remote_artist = coalesce(:remoteArtist, remote_artist),
    remote_description = coalesce(:remoteDescription, remote_description),
    remote_genre = coalesce(:remoteGenre, remote_genre),
    remote_status = coalesce(:remoteStatus, remote_status),
    remote_cover = coalesce(:remoteCover, remote_cover),
    remote_update_strategy = coalesce(:remoteUpdateStrategy, remote_update_strategy),
    remote_memo = coalesce(:remoteMemo, remote_memo),
    user_favorite_at = :userFavoriteAt,
    user_notes = coalesce(:userNotes, user_notes),
    user_reader_flags = coalesce(:userReaderFlags, user_reader_flags),
    user_chapter_flags = coalesce(:userChapterFlags, user_chapter_flags),
    state_chapter_last_update = coalesce(:stateChapterLastUpdate, state_chapter_last_update),
    state_cover_last_modified = coalesce(:stateCoverLastModified, state_cover_last_modified),
    state_initialized = coalesce(:stateInitialized, state_initialized)
WHERE id = :id;

updateRemote:
UPDATE manga SET
    remote_title = coalesce(:remoteTitle, remote_title),
    remote_author = coalesce(:remoteAuthor, remote_author),
    remote_artist = coalesce(:remoteArtist, remote_artist),
    remote_description = coalesce(:remoteDescription, remote_description),
    remote_genre = coalesce(:remoteGenre, remote_genre),
    remote_status = :remoteStatus,
    remote_cover = coalesce(:remoteCover, remote_cover),
    remote_update_strategy = :remoteUpdateStrategy,
    remote_memo = :remoteMemo,
    state_cover_last_modified = coalesce(:stateCoverLastModified, state_cover_last_modified),
    state_initialized = :stateInitialized
WHERE id = :id;

insertNetworkManga {
    -- A new entry is inserted as the source reported it. An existing one takes the fresh details
    -- only while it is outside the library, so a library entry keeps what the user already has.
    INSERT INTO manga(
        source_id, remote_url, remote_title, remote_author, remote_artist, remote_description,
        remote_genre, remote_status, remote_cover, remote_update_strategy, remote_memo,
        user_favorite_at, user_notes, user_reader_flags, user_chapter_flags,
        state_chapter_last_update, state_chapter_next_update, state_chapter_fetch_interval,
        state_cover_last_modified, state_initialized
    )
    VALUES (
        :sourceId, :remoteUrl, :remoteTitle, :remoteAuthor, :remoteArtist, :remoteDescription,
        :remoteGenre, :remoteStatus, :remoteCover, :remoteUpdateStrategy, :remoteMemo,
        :userFavoriteAt, '', :userReaderFlags, :userChapterFlags,
        :stateChapterLastUpdate, :stateChapterNextUpdate, :stateChapterFetchInterval,
        :stateCoverLastModified, :stateInitialized
    )
    ON CONFLICT(source_id, remote_url) DO UPDATE SET
        remote_title = CASE WHEN :updateTitle THEN excluded.remote_title ELSE remote_title END,
        remote_cover = CASE WHEN :updateCover THEN excluded.remote_cover ELSE remote_cover END,
        remote_author = CASE WHEN :updateDetails THEN excluded.remote_author ELSE remote_author END,
        remote_artist = CASE WHEN :updateDetails THEN excluded.remote_artist ELSE remote_artist END,
        remote_description = CASE WHEN :updateDetails THEN excluded.remote_description ELSE remote_description END,
        remote_genre = CASE WHEN :updateDetails THEN excluded.remote_genre ELSE remote_genre END,
        remote_status = CASE WHEN :updateDetails THEN excluded.remote_status ELSE remote_status END,
        remote_update_strategy = CASE
            WHEN :updateDetails THEN excluded.remote_update_strategy
            ELSE remote_update_strategy
        END,
        remote_memo = excluded.remote_memo,
        state_initialized = :updateDetails
    WHERE user_favorite_at IS NULL;

    SELECT
        id, source_id, remote_url, remote_title, remote_author, remote_artist, remote_description,
        remote_genre, remote_status, remote_cover, remote_update_strategy, remote_memo,
        user_favorite_at, user_notes, user_reader_flags, user_chapter_flags,
        state_chapter_last_update, state_chapter_next_update, state_chapter_fetch_interval,
        state_cover_last_modified, state_initialized
    FROM manga
    WHERE source_id = :sourceId
    AND remote_url = :remoteUrl;
}
