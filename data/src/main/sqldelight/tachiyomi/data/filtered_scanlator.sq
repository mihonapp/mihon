CREATE TABLE filtered_scanlator(
    manga_id INTEGER NOT NULL,
    scanlator TEXT NOT NULL,
    UNIQUE(manga_id, scanlator),
    FOREIGN KEY(manga_id) REFERENCES manga (id)
    ON DELETE CASCADE
);


insert:
INSERT INTO filtered_scanlator(manga_id, scanlator)
VALUES (:mangaId, :scanlator)
ON CONFLICT(manga_id, scanlator) DO NOTHING;

remove:
DELETE FROM filtered_scanlator
WHERE manga_id = :mangaId
AND scanlator IN :scanlators;

getFilteredScanlatorsByMangaId:
SELECT scanlator
FROM filtered_scanlator
WHERE manga_id = :mangaId;

getFilteredScanlatorsByMangaIds:
SELECT manga_id, scanlator
FROM filtered_scanlator
WHERE manga_id IN :mangaIds
ORDER BY manga_id, scanlator;
