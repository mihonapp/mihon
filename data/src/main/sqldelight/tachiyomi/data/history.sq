import java.util.Date;

CREATE TABLE history(
    id INTEGER NOT NULL PRIMARY KEY,
    manga_id INTEGER NOT NULL,
    chapter_id INTEGER NOT NULL UNIQUE,
    read_at INTEGER AS Date,
    read_duration INTEGER NOT NULL,
    FOREIGN KEY(manga_id) REFERENCES manga (id)
    ON DELETE CASCADE,
    FOREIGN KEY(chapter_id) REFERENCES chapter (id)
    ON DELETE CASCADE
);

CREATE INDEX history_manga_id_index ON history(manga_id);
CREATE INDEX history_read_at_index ON history(read_at);

getHistoryByMangaId:
SELECT
H.id,
H.chapter_id,
H.read_at,
H.read_duration
FROM history H
JOIN chapter C
ON H.chapter_id = C.id
WHERE C.manga_id = :mangaId AND C.id = H.chapter_id;

getHistoryByChapterUrlAndMangaId:
SELECT
H.id,
H.chapter_id,
H.read_at,
H.read_duration
FROM history H
JOIN chapter C
ON H.chapter_id = C.id
WHERE C.remote_url = :chapterUrl AND C.manga_id = :mangaId AND C.id = H.chapter_id
LIMIT 1;

resetHistoryById:
UPDATE history
SET read_at = 0
WHERE id = :historyId;

resetHistoryByMangaId:
UPDATE history
SET read_at = 0
WHERE id IN (
    SELECT H.id
    FROM manga M
    INNER JOIN chapter C
    ON M.id = C.manga_id
    INNER JOIN history H
    ON C.id = H.chapter_id
    WHERE M.id = :mangaId
);

removeAllHistory:
DELETE FROM history;

removeResettedHistory:
DELETE FROM history
WHERE read_at = 0;

upsert:
INSERT INTO history(manga_id, chapter_id, read_at, read_duration)
SELECT C.manga_id, :chapterId, :readAt, :time_read
FROM chapter C
WHERE C.id = :chapterId
ON CONFLICT(chapter_id)
DO UPDATE
SET
    read_at = :readAt,
    read_duration = read_duration + :time_read
WHERE chapter_id = :chapterId;

getReadDuration:
SELECT coalesce(sum(read_duration), 0)
FROM history;
