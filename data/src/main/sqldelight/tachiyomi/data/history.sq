import kotlin.time.Instant;

CREATE TABLE history(
    id INTEGER NOT NULL PRIMARY KEY,
    manga_id INTEGER NOT NULL,
    chapter_id INTEGER NOT NULL UNIQUE,
    read_at INTEGER AS Instant,
    read_duration INTEGER NOT NULL,
    FOREIGN KEY(manga_id) REFERENCES manga (id)
    ON DELETE CASCADE,
    FOREIGN KEY(chapter_id) REFERENCES chapter (id)
    ON DELETE CASCADE
);

CREATE INDEX history_manga_id_index ON history(manga_id);
CREATE INDEX history_read_at_index ON history(read_at);

getHistoryByMangaId:
SELECT id, chapter_id, read_at, read_duration
FROM history
WHERE manga_id = :mangaId;

resetHistoryById:
UPDATE history
SET read_at = NULL
WHERE id = :id;

resetHistoryByMangaId:
UPDATE history
SET read_at = NULL
WHERE manga_id = :mangaId;

removeAllHistory:
DELETE FROM history;

removeResettedHistory:
DELETE FROM history
WHERE read_at IS NULL;

upsert:
INSERT INTO history(manga_id, chapter_id, read_at, read_duration)
SELECT manga_id, id, :readAt, :readDuration
FROM chapter
WHERE id = :chapterId
ON CONFLICT(chapter_id) DO UPDATE SET
    read_at = excluded.read_at,
    read_duration = read_duration + excluded.read_duration;

getReadDuration:
SELECT coalesce(sum(read_duration), 0)
FROM history;

getReadDurationByManga:
SELECT
    M.id AS manga_id,
    M.remote_title AS title,
    COALESCE(SUM(H.read_duration), 0) AS total_time_read,
    M.source_id AS source_id,
    M.user_favorite_at IS NOT NULL AS is_favorite,
    M.remote_cover AS thumbnail_url,
    M.state_cover_last_modified AS cover_last_modified
FROM manga M
INNER JOIN history H ON M.id = H.manga_id
GROUP BY M.id
HAVING total_time_read > 0
ORDER BY total_time_read DESC
LIMIT 500;

getReadDurationForManga:
SELECT COALESCE(SUM(read_duration), 0)
FROM history
WHERE manga_id = :mangaId;

getReadDurationForMangaByTitle:
SELECT COALESCE(SUM(H.read_duration), 0)
FROM history H
JOIN manga M ON H.manga_id = M.id
WHERE LOWER(TRIM(M.remote_title)) = LOWER(TRIM(:title));
