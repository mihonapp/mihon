import java.util.Date;

CREATE TABLE history(
    id INTEGER NOT NULL PRIMARY KEY,
    manga_id INTEGER NOT NULL,
    chapter_id INTEGER NOT NULL UNIQUE,
    read_at INTEGER AS Date,
    read_duration INTEGER NOT NULL,
    FOREIGN KEY(manga_id) REFERENCES manga (id)
    ON DELETE CASCADE,
    FOREIGN KEY(chapter_id) REFERENCES chapter (id)
    ON DELETE CASCADE
);

CREATE INDEX history_manga_id_index ON history(manga_id);
CREATE INDEX history_read_at_index ON history(read_at);

getHistoryByMangaId:
SELECT id, chapter_id, read_at, read_duration
FROM history
WHERE manga_id = :mangaId;

resetHistoryById:
UPDATE history
SET read_at = 0
WHERE id = :id;

resetHistoryByMangaId:
UPDATE history
SET read_at = 0
WHERE manga_id = :mangaId;

removeAllHistory:
DELETE FROM history;

removeResettedHistory:
DELETE FROM history
WHERE read_at = 0;

upsert {
    INSERT INTO history(manga_id, chapter_id, read_at, read_duration)
    SELECT manga_id, id, :readAt, :readDuration
    FROM chapter
    WHERE id = :chapterId
    ON CONFLICT(chapter_id) DO UPDATE SET
        read_at = excluded.read_at,
        read_duration = read_duration + excluded.read_duration;

    UPDATE manga
    SET user_last_read_at = max(user_last_read_at, coalesce(:readAt, 0))
    WHERE id = (SELECT manga_id FROM chapter WHERE id = :chapterId);
}

getReadDuration:
SELECT coalesce(sum(read_duration), 0)
FROM history;

resetLastReadIfNoHistory:
UPDATE manga
SET user_last_read_at = 0
WHERE (:mangaId IS NULL OR id = :mangaId)
AND NOT EXISTS (
    SELECT 1 FROM history AS H
    JOIN chapter AS C ON C.id = H.chapter_id
    LEFT JOIN excluded_scanlator AS ES ON ES.manga_id = H.manga_id AND ES.scanlator = C.remote_scanlator
    WHERE H.manga_id = manga.id AND H.read_at != 0 AND ES.scanlator IS NULL
);
