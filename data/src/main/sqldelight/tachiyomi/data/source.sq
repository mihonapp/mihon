CREATE TABLE source(
    id INTEGER NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    language TEXT NOT NULL
);

findAll:
SELECT id, language, name
FROM source;

findOne:
SELECT id, language, name
FROM source
WHERE id = :id;

upsert:
INSERT INTO source(id, language, name)
VALUES (:id, :lang, :name)
ON CONFLICT(id)
DO UPDATE
SET
    language = :lang,
    name = :name
WHERE id = :id;
