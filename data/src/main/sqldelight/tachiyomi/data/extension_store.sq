import kotlin.Boolean;

CREATE TABLE extension_store(
    index_url TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    badge_label TEXT NOT NULL,
    signing_key TEXT NOT NULL,
    contact_website TEXT NOT NULL,
    contact_discord TEXT,
    is_legacy INTEGER AS Boolean NOT NULL,
    extension_list_url TEXT,
    is_enabled INTEGER AS Boolean NOT NULL DEFAULT 1
);

contains:
SELECT EXISTS(SELECT 0 FROM extension_store WHERE index_url = :indexUrl);

getAll:
SELECT
    index_url, name, badge_label, signing_key,
    contact_website, contact_discord, is_legacy, extension_list_url, is_enabled
FROM extension_store;

getEnabled:
SELECT
    index_url, name, badge_label, signing_key,
    contact_website, contact_discord, is_legacy, extension_list_url, is_enabled
FROM extension_store
WHERE is_enabled = 1;

getCount:
SELECT count(*)
FROM extension_store;

upsert:
INSERT INTO extension_store(
    index_url, name, badge_label, signing_key, contact_website, contact_discord, is_legacy,
    extension_list_url, is_enabled
)
VALUES (
    :indexUrl, :name, :badgeLabel, :signingKey, :contactWebsite, :contactDiscord, :isLegacy,
    :extensionListUrl, :isEnabled
)
ON CONFLICT(index_url) DO UPDATE SET
    name = excluded.name,
    badge_label = excluded.badge_label,
    signing_key = excluded.signing_key,
    contact_website = excluded.contact_website,
    contact_discord = excluded.contact_discord,
    is_legacy = excluded.is_legacy,
    extension_list_url = excluded.extension_list_url;

setEnabled:
UPDATE extension_store
SET is_enabled = :isEnabled
WHERE index_url = :indexUrl;

delete:
DELETE FROM extension_store
WHERE index_url = :indexUrl;
