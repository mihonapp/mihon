CREATE VIEW libraryView AS
SELECT
    M.*,
    coalesce(C.total, 0) AS totalCount,
    coalesce(C.readCount, 0) AS readCount,
    C.latestUpload AS latestUpload,
    C.fetchedAt AS chapterFetchedAt,
    -- Joining history to every chapter is the slowest part of the query, and only entries with filtered
    -- scanlators need the chapters to leave theirs out
    CASE WHEN EXISTS (SELECT 0 FROM filtered_scanlator WHERE filtered_scanlator.manga_id = M.id)
    THEN (
        SELECT max(history.read_at)
        FROM history
        JOIN chapter
        ON chapter.id = history.chapter_id
        WHERE history.manga_id = M.id
        AND (M.user_chapter_flags & 128 != 0) = EXISTS (
            SELECT 0 FROM filtered_scanlator
            WHERE filtered_scanlator.manga_id = M.id
            AND filtered_scanlator.scanlator = chapter.remote_scanlator
        )
    )
    ELSE (SELECT max(history.read_at) FROM history WHERE history.manga_id = M.id)
    END AS lastRead,
    coalesce(C.bookmarkCount, 0) AS bookmarkCount,
    coalesce(MC.categories, '0') AS categories
FROM manga M
LEFT JOIN (
    SELECT
        chapter.manga_id,
        count(*) AS total,
        sum(user_read) AS readCount,
        max(chapter.remote_date_upload) AS latestUpload,
        max(chapter.state_date_fetch) AS fetchedAt,
        sum(chapter.user_bookmark) AS bookmarkCount
    FROM chapter
    JOIN manga
    ON manga.id = chapter.manga_id
    LEFT JOIN filtered_scanlator
    ON chapter.manga_id = filtered_scanlator.manga_id
    AND chapter.remote_scanlator = filtered_scanlator.scanlator
    WHERE manga.user_favorite_at IS NOT NULL
    AND CASE
        WHEN manga.user_chapter_flags & 128 != 0
            AND EXISTS (SELECT 0 FROM filtered_scanlator FS WHERE FS.manga_id = manga.id)
        THEN filtered_scanlator.scanlator IS NOT NULL
        ELSE filtered_scanlator.scanlator IS NULL
    END
    GROUP BY chapter.manga_id
) AS C
ON M.id = C.manga_id
LEFT JOIN (
    SELECT manga_id, group_concat(category_id) AS categories
    FROM manga_category
    WHERE manga_id IN (SELECT id FROM manga WHERE user_favorite_at IS NOT NULL)
    GROUP BY manga_id
) AS MC
ON MC.manga_id = M.id
WHERE M.user_favorite_at IS NOT NULL;

library:
SELECT
    id, source_id, remote_url, remote_title, remote_author, remote_artist, remote_description,
    remote_genre, remote_status, remote_cover, remote_update_strategy, remote_memo,
    user_favorite_at, user_notes, user_reader_flags, user_chapter_flags,
    state_chapter_last_update, state_chapter_next_update, state_chapter_fetch_interval,
    state_cover_last_modified, state_initialized, totalCount, readCount, latestUpload,
    chapterFetchedAt, lastRead, bookmarkCount, categories
FROM libraryView;
